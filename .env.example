# ---- MySQL (XAMPP defaults shown) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prodyum

# ---- Admin Auth ----
# Use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-long-random-string
# Optional: key used to encrypt the SMTP password at rest (falls back to JWT_SECRET).
# ENCRYPTION_KEY=another-long-random-string
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=change-me

# ---- Server ----
PORT=5000
# Comma-separated origins allowed to call the API from a browser (optional)
# CORS_ORIGIN=https://your-production-domain.com
